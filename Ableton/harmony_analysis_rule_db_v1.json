  "melody_alignment_rules": {
    "description": "Melody-aware accompaniment and top-note handling.",
    "rules": [
      {
        "id": "mar_follow_melody_support",
        "mode": "follow_melody",
        "description": "Top note may double melody when accompaniment is supportive and texture is sparse or medium.",
        "top_note_relation_to_melody": [
          {"interval_semitones": 0, "score": 1.0},
          {"interval_semitones": -12, "score": 0.85},
          {"interval_semitones": -3, "score": 0.6, "context": "parallel_harmony"},
          {"interval_semitones": -4, "score": 0.6, "context": "parallel_harmony"}
        ]
      },
      {
        "id": "mar_avoid_minor9_clash",
        "mode": "protect_melody",
        "description": "Avoid top note creating harsh minor ninth clash against melody on strong beats.",
        "forbidden_intervals_against_melody_on_strong_beat": [1, 13, -1, -13],
        "penalty_if_exceeded": 1.0
      },
      {
        "id": "mar_prefer_chord_tone_under_nonchord_melody",
        "mode": "support_melody",
        "description": "If melody note is a passing tone / neighbor / suspension, accompaniment top note should prefer stable chord tone.",
        "if_melody_role": ["passing_tone", "neighbor_tone", "suspension"],
        "preferred_top_note_degrees": ["3", "7", "1", "5"],
        "score_boost": 0.25
      },
      {
        "id": "mar_counter_motion",
        "mode": "counter_line",
        "description": "Prefer gentle contrary or oblique motion against melody in lyrical accompaniment.",
        "preferred_motion_relative_to_melody": ["contrary", "oblique"],
        "acceptable_motion_relative_to_melody": ["similar_stepwise"],
        "discouraged_motion_relative_to_melody": ["similar_large_leap"]
      }
    ]
  },
