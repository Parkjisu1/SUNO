{
  "schema_version": "1.0",
  "project_name": "MIDI Harmony Analyzer Rule DB",
  "purpose": "Rule database and analysis philosophy for a piano accompaniment harmony analyzer that evaluates MIDI against jazz/pop accompaniment rules while remaining sensitive to arpeggio context, melody support, inversion logic, playability, and voice leading.",
  "design_philosophy": {
    "summary": [
      "Do not label harmony only by collecting all sounding pitches equally.",
      "Separate structural harmony from surface notes.",
      "In arpeggio/accompaniment contexts, short decorative notes should not automatically force richer chord labels.",
      "Prefer stable, musically practical chord labels over overly literal pitch-set labels.",
      "Return a primary label plus alternate candidates with confidence and reasons.",
      "Melody has higher priority than accompaniment top-note freedom.",
      "Reject or penalize voicings that are physically impractical or aesthetically muddy on piano.",
      "Treat rules as weighted preferences, not absolute truth, except for hard constraints."
    ],
    "analysis_layers": [
      {
        "layer": "structural_harmony",
        "description": "The main chord identity for the segment/bar/beat.",
        "examples": ["Dm7", "Fmaj7/A", "Bb", "G7"]
      },
      {
        "layer": "surface_notes",
        "description": "Passing tones, arpeggio traversal notes, decorative extensions, neighbor tones, suspensions, and melody-driven color notes that do not necessarily redefine the structural chord.",
        "examples": ["E as 9 over Dm7 in an arpeggio", "F as b13 over Am7 candidate but not primary label"]
      },
      {
        "layer": "contextual_interpretation",
        "description": "Phrase context, surrounding chords, bass motion, inversion preference, melody relation, and accompaniment style determine the final preferred label."
      }
    ],
    "priority_order": [
      "melody_protection",
      "chord_conformity",
      "human_playability",
      "voice_leading",
      "style_consistency",
      "surface_color_interpretation"
    ]
  },
  "hard_constraints": {
    "description": "Violations here should reject candidates or heavily penalize them.",
    "rules": [
      {
        "id": "hc_melody_minor9_strong_beat",
        "type": "melody_clash",
        "description": "Avoid harsh minor ninth / major seventh clashes between melody and accompaniment top note on strong beats.",
        "forbidden_intervals_semitones": [1, -1, 11, -11, 13, -13],
        "severity": "high"
      },
      {
        "id": "hc_unplayable_span",
        "type": "playability",
        "description": "Reject voicings that exceed reasonable hand span unless advanced mode is explicitly enabled.",
        "left_hand_max_semitones": 12,
        "right_hand_max_semitones": 11,
        "severity": "high"
      },
      {
        "id": "hc_low_register_mud_cluster",
        "type": "register_density",
        "description": "Avoid dense clusters in low register.",
        "forbidden_if": {
          "lowest_note_below_midi": 48,
          "adjacent_interval_semitones_lte": 2,
          "simultaneous_notes_gte": 3
        },
        "severity": "high"
      },
      {
        "id": "hc_cross_hand_chaos",
        "type": "hand_order",
        "description": "Avoid right hand consistently placed below left hand top note unless intentionally marked as special texture.",
        "severity": "medium_high"
      },
      {
        "id": "hc_outside_chord_without_context",
        "type": "harmonic_fit",
        "description": "Non-chord tones that are not explainable as passing, neighbor, suspension, arpeggio color, or melody-support note should be heavily penalized.",
        "severity": "high"
      }
    ]
  },
  "soft_constraints": {
    "description": "Weighted preferences used for scoring among valid candidates.",
    "rules": [
      {
        "id": "sc_stepwise_top_note",
        "type": "top_note_motion",
        "preferred_intervals_semitones": [0, 1, 2, -1, -2],
        "acceptable_intervals_semitones": [3, 4, 5, -3, -4, -5],
        "discouraged_intervals_semitones": [6, 7, 8, 9, 10, 11, 12, -6, -7, -8, -9, -10, -11, -12]
      },
      {
        "id": "sc_common_tone_retention",
        "type": "voice_leading",
        "description": "Prefer retaining one or two common tones between adjacent chords when musically appropriate."
      },
      {
        "id": "sc_inner_voice_min_motion",
        "type": "voice_leading",
        "description": "Prefer minimal motion in inner voices unless tension build is intended."
      },
      {
        "id": "sc_stable_primary_label",
        "type": "labeling_bias",
        "description": "Prefer a musically stable, practical structural chord label over an overly literal pitch-set label when both are explainable.",
        "examples": [
          "Prefer Dm7 + surface 9 over forcing Dm9 as structural label in a simple arpeggio context",
          "Prefer Fmaj9/A over Am7(b13) when F-centered context is stronger"
        ]
      }
    ]
  },
  "analysis_context_rules": {
    "arpeggio_sensitive_analysis": {
      "description": "Short decorative notes in an arpeggio should not automatically redefine structural harmony.",
      "rules": [
        {
          "id": "arp_structural_weighting",
          "description": "Weight bass notes, long notes, metrically strong notes, and repeated tones more heavily than short traversal tones.",
          "weight_bias": {
            "bass_note": 1.4,
            "long_duration": 1.25,
            "strong_beat": 1.2,
            "repeated_tone": 1.15,
            "short_traversal_note": 0.65
          }
        },
        {
          "id": "arp_surface_extension_tagging",
          "description": "If a color tone appears briefly in arpeggio context but the structural triad/seventh remains stable, tag it as surface extension instead of forcing a structural relabel.",
          "examples": [
            {
              "input_pitch_set_context": "D-F-A with brief E in arpeggio",
              "preferred_structural_label": "Dm7",
              "surface_extension": "9"
            }
          ]
        },
        {
          "id": "arp_no_hyper_relabeling",
          "description": "Do not continuously relabel every decorative arpeggio tone as a new chord unless accent, duration, repetition, or bass support justifies it."
        }
      ]
    },
    "candidate_labeling_policy": {
      "description": "Return a preferred label plus alternate candidates with score and explanation.",
      "rules": [
        {
          "id": "cand_primary_plus_alternates",
          "description": "Every ambiguous segment should provide at least one selected label and up to three alternate candidates when relevant."
        },
        {
          "id": "cand_context_bias",
          "description": "Bias candidate ranking by phrase context, surrounding harmony, bass placement, chord completeness, and practical readability."
        }
      ]
    }
  },
